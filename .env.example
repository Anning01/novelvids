# 复制为 .env 后按需修改（本地开发用）。
# Docker 部署无需此文件，环境变量由 docker-compose.yml 注入。

# 数据库连接串
# 默认 SQLite；生产可切换 PostgreSQL，例如：
#   postgres://user:password@host:5432/novelvids
DATABASE_URL=sqlite://./data/novelvids.db

# 媒体文件目录（生成的图片 / 视频 / 音频）
MEDIA_PATH=./media

# 调试模式
DEBUG=true

# 启动时自动创建缺失的数据表（首次运行建议 true）
GENERATE_SCHEMAS=true

# ---- HTTP 安全（生产环境务必显式配置） ----
# 正式商业站建议关闭接口文档；可信演示环境可按需开启。
API_DOCS_ENABLED=true
SECURITY_HEADERS_ENABLED=false
# 生产环境必须 false，避免未处理异常向客户端回显内部信息。
EXPOSE_INTERNAL_ERRORS=true
# 逗号分隔；生产环境填写真实域名，不要保留 *。
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=false
# 只信任直连反向代理的 IP/CIDR；不要填写客户端公网网段。
TRUSTED_PROXY_NETWORKS=127.0.0.1/32,::1/128

# 登录双层限流：每 IP 总尝试窗口 + IP/用户名失败窗口。
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_IP_ATTEMPTS=30
LOGIN_RATE_LIMIT_IP_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_FAILURES=5
LOGIN_RATE_LIMIT_FAILURE_WINDOW_SECONDS=900

# ---- 登录与团队功能（默认关闭） ----
# 开启后：必须登录才能使用，并默认启用团队功能（角色/成员/团队管理/官方配置/余额）。
# 首次开启前请配置下面的超管引导账号。
AUTH_ENABLED=false

# 登录会话有效期（小时）
SESSION_TTL_HOURS=168

# 超级管理员引导账号：AUTH_ENABLED=true 且系统中尚无超管时自动创建。
# 首次登录后请立即修改密码。留空则不自动创建。
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=

# 空表启动时是否灌入内置模型和媒体库数据。普通部署保持 true；
# 无外部模型、无 OSS 的只读演示环境可设为 false。
MODEL_CONFIG_SEED_ENABLED=true
MEDIA_LIBRARY_SEED_ENABLED=true

# ---- 二期：微信公众号扫码登录（资质就绪后配置） ----
# WECHAT_MP_APP_ID=
# WECHAT_MP_APP_SECRET=
# WECHAT_MP_TOKEN=
# WECHAT_MP_AES_KEY=

# ---- 对象存储（默认 local：本地磁盘，行为不变） ----
# OSS_PROVIDER=local                                   # local | aliyun
# OSS_BUCKET=dramas-x
# OSS_ENDPOINT=oss-cn-guangzhou.aliyuncs.com            # 地域 endpoint，程序自动拼 Bucket 虚拟主机域名
# OSS_INTERNAL_ENDPOINT=oss-cn-guangzhou-internal.aliyuncs.com  # 服务端读写（同地域 ECS 免流量费）
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_PUBLIC_BASE=                                      # 可选 CNAME/CDN 读访问前缀，留空用 https://{bucket}.{endpoint}
# OSS_URL_EXPIRES_SECONDS=604800                        # 私有 Bucket 签名 URL 有效期（秒），默认 7 天

# ---- 视频异步任务自动收口 ----
# 后端自动查询供应商任务，不依赖浏览器页面持续打开。
VIDEO_RECONCILE_INTERVAL_SECONDS=30
VIDEO_RECONCILE_BATCH_SIZE=50
