# 复制为 .env 后按需修改（本地开发用）。
# Docker 部署无需此文件，环境变量由 docker-compose.yml 注入。

# 数据库连接串
# 默认 SQLite；生产可切换 PostgreSQL，例如：
#   postgres://user:password@host:5432/novelvids
DATABASE_URL=sqlite://./data/novelvids.db

# 媒体文件目录（生成的图片 / 视频 / 音频）
MEDIA_PATH=./media

# 调试模式
DEBUG=true

# 启动时自动创建缺失的数据表（首次运行建议 true）
GENERATE_SCHEMAS=true
