# 真实 LLM 测试配置
# 复制此文件为 .test.env 并填入真实值后，使用 pytest -m real_llm 运行真实测试

# 提取任务配置
EXTRACTION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EXTRACTION_API_KEY=your-api-key-here
EXTRACTION_MODEL=doubao-seed-1-8-251228

# 创作助手工具调用配置（可与上方使用同一兼容端点，模型必须支持 tools）
CREATION_AGENT_BASE_URL=https://your-openai-compatible-endpoint/v1
CREATION_AGENT_API_KEY=your-api-key-here
CREATION_AGENT_MODEL=your-tool-capable-model
# 可选：供应商单独公布缓存命中输入价时填写，未填写则按普通输入价保守核算
CREATION_AGENT_CACHE_INPUT_PRICE_CNY_PER_1M=0.15
