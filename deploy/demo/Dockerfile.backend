# syntax=docker/dockerfile:1.7
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
ARG UV_INDEX_URL=https://pypi.org/simple
COPY pyproject.toml uv.lock ./
RUN UV_INDEX_URL="${UV_INDEX_URL}" uv sync --frozen --no-dev --no-install-project

FROM python:3.12-slim AS runtime

RUN groupadd --gid 10001 novelvids \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin novelvids
WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH"

COPY --from=builder --chown=10001:10001 /app/.venv /app/.venv
COPY --chown=10001:10001 . .
RUN mkdir -p /app/data /app/media && chown -R 10001:10001 /app/data /app/media

USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log"]
